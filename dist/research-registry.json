    "islamic-state-ethnosectarian-attack-patterns": {
      "id": "islamic-state-ethnosectarian-attack-patterns",
      "title": "Counterterrorism, Ethnosectarian Context and Islamic State Attack Patterns",
      "short_title": "Islamic State Attack Patterns",
      "repository": "LystadJS/counterterrorism_ethnosectarian_islamic_state",
      "url": "https://github.com/LystadJS/counterterrorism_ethnosectarian_islamic_state",
      "type": "academic-research",
      "status": "active",
      "featured": true,
      "summary": "Reproducible analysis of Islamic State-linked attack patterns in Iraq using terrorism-event data, district-level ethnosectarian composition, spatial boundaries, population weighting, diagnostics, and statistical modeling.",
      "methods": [
        {
          "id": "spatial-statistics",
          "role": "primary",
          "techniques": [
            "spatial-analysis",
            "population-weighted-geography",
            "spatial-visualization"
          ],
          "usage": "Links attack events to Iraqi district geography and population-weighted ethnosectarian composition, with spatial validation and visualization."
        },
        {
          "id": "missing-data",
          "role": "secondary",
          "techniques": [
            "missingness-diagnostics"
          ],
          "usage": "Uses explicit missingness audits and diagnostic workflows as part of reproducible event-data preparation and interpretation."
        },
        {
          "id": "statistical-computing",
          "role": "secondary",
          "techniques": [
            "statistical-modeling",
            "data-visualization",
            "reproducible-computing"
          ],
          "usage": "Uses modular R workflows, saved analytical objects, diagnostics, and publication-oriented figures to make analytical decisions reproducible."
        }
      ],
