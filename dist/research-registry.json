  "projects": {
    "ai-governance-non-proliferation": {
      "id": "ai-governance-non-proliferation",
      "title": "Artificial Intelligence Governance and Non-Proliferation",
      "short_title": "AI Governance and Non-Proliferation",
      "repository": "LystadJS/project-ai-governance-non-proliferation",
      "url": "https://github.com/LystadJS/project-ai-governance-non-proliferation",
      "type": "applied-research",
      "status": "active",
      "featured": true,
      "summary": "Public reproducibility layer for applied analysis of AI governance, non-proliferation, institutional process terrain, and multilateral policy using releasable statistical and visualization workflows.",
      "methods": [
        {
          "id": "dimension-reduction",
          "role": "primary",
          "techniques": [
            "multidimensional-scaling"
          ],
          "usage": "Uses principal coordinates analysis on a structured process-evidence distance matrix to represent similarity among multilateral venues and processes."
        },
        {
          "id": "statistical-computing",
          "role": "secondary",
          "techniques": [
            "data-visualization",
            "reproducible-computing"
          ],
          "usage": "Uses deterministic R workflows to reproduce process-terrain coordinates, diagnostics, and a publication-style strategic-terrain visualization."
        }
      ],
