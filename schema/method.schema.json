{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lystadjs.github.io/schema/method.schema.json",
  "title": "JSL Method Hub Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "repository",
        "status",
        "summary",
        "family",
        "aliases",
        "techniques",
        "related_methods",
        "languages"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 2
        },
        "repository": {
          "type": "string",
          "pattern": "^LystadJS/[A-Za-z0-9._-]+$"
        },
        "status": {
          "enum": [
            "planned",
            "active",
            "archived"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 20
        },
        "family": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "techniques": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "related_methods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
